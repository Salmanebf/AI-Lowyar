# =============================================================================
# MoroLex — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (used by gateway via Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://morolex:morolex_dev@localhost:5432/morolex

# -----------------------------------------------------------------------------
# Redis (rate limits, cache, queues)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Gateway (apps/gateway)
# -----------------------------------------------------------------------------
PORT=3000
JWT_SECRET=replace-with-a-secure-random-string
JWT_EXPIRATION=7d
AI_SERVICE_URL=http://localhost:8000
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# -----------------------------------------------------------------------------
# Web (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# -----------------------------------------------------------------------------
# AI Service (apps/ai-service) — prefixed with MOROLEX_
# -----------------------------------------------------------------------------
MOROLEX_DEBUG=true
MOROLEX_HOST=0.0.0.0
MOROLEX_PORT=8000
MOROLEX_ANTHROPIC_API_KEY=sk-ant-replace-me
MOROLEX_COHERE_API_KEY=replace-with-cohere-api-key
MOROLEX_QDRANT_URL=http://localhost:6333
MOROLEX_QDRANT_COLLECTION=legal_corpus
MOROLEX_GATEWAY_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
