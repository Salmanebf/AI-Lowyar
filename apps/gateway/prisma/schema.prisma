generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  passwordHash      String?        @map("password_hash")
  oauthProvider     String?        @map("oauth_provider")
  oauthId           String?        @map("oauth_id")
  preferredLanguage String         @default("fr") @map("preferred_language")
  role              String         @default("user")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  telegramUserId    BigInt?        @unique @map("telegram_user_id")

  conversations     Conversation[]
  feedback          Feedback[]
  usageLogs         UsageLog[]

  @@map("users")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  channel   String
  title     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  language       String?
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       Feedback[]

  @@map("messages")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int?     @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model LegalDocument {
  id            String   @id @default(uuid()) @db.Uuid
  code          String
  book          String?
  titleNumber   String?  @map("title_number")
  chapter       String?
  section       String?
  articleNumber String   @map("article_number")
  language      String
  content       String
  versionDate   DateTime? @map("version_date") @db.Date
  sourceUrl     String?  @map("source_url")
  checksum      String?
  isCurrent     Boolean  @default(true) @map("is_current")
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([code, articleNumber, language, isCurrent], map: "legal_documents_code_article_number_language_is_current_idx")
  @@map("legal_documents")
}

model UsageLog {
  id               BigInt   @id @default(autoincrement())
  userId           String?  @map("user_id") @db.Uuid
  conversationId   String?  @map("conversation_id") @db.Uuid
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?     @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("usage_logs")
}
